{
  "name": "ultimatrix",
  "version": "2.0.1",
  "description": "AI security researcher. Composer + 29 primitives, dynamically spawns specialist agents. Real exploit chains across 10 attack classes.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ultimatrix": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup && next build",
    "build:cli": "tsup",
    "build:web": "next build",
    "dev": "next dev",
    "web": "next dev",
    "start": "next start",
    "cli": "node --import tsx src/cli/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "clean": "rm -rf dist .next",
    "validate": "node scripts/validate-setup.js",
    "demo": "node scripts/quick-demo.js",
    "test:runner": "node scripts/test-runner.js"
  },
  "keywords": [
    "security",
    "pentesting",
    "ai-agents",
    "vulnerability-scanner",
    "red-team",
    "devsecops",
    "llm",
    "composer",
    "primitives",
    "recursion",
    "spawn-agents",
    "waf-bypass",
    "idor",
    "xss",
    "sqli",
    "ssti",
    "ssrf",
    "xxe",
    "csrf",
    "file-upload",
    "open-redirect",
    "security-headers"
  ],
  "author": "Shanthosh",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@libsql/client": "^0.17.3",
