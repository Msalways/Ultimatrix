{
  "name": "ultimatrix",
  "version": "2.0.0",
  "description": "AI security researcher. Composer + 21 primitives, dynamically spawns specialist agents. Real exploit chains across 10 attack classes.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ultimatrix": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli/index.ts",
    "cli": "tsx src/cli/index.ts",
    "demo": "tsx src/cli/index.ts demo",
    "web": "tsx src/cli/index.ts web",
    "start": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "security",
    "pentesting",
    "ai-agents",
    "vulnerability-scanner",
    "red-team",
    "devsecops",
    "llm",
    "composer",
    "primitives",
    "recursion",
    "spawn-agents",
    "waf-bypass",
    "idor",
    "xss",
    "sqli",
    "ssti",
    "ssrf",
    "xxe",
    "csrf",
    "file-upload",
    "open-redirect",
    "security-headers"
  ],
  "author": "Ultimatrix Team",
  "license": "MIT",
  "dependencies": {
    "@browserbasehq/stagehand": "^3.5.0",
    "@mastra/agent-browser": "^0.3.0",
    "@mastra/core": "^1.41.0",
    "@mastra/memory": "^1.20.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nicia-ai/typegraph": "^0.31.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "js-yaml": "^4.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "playwright": "^1.40.0",
    "terminui": "^0.3.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "fast-check": "^4.8.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  }
}
