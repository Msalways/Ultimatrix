    "@mastra/libsql": "^1.13.0",
    "@mastra/loggers": "^1.1.2",
    "@mastra/memory": "^1.20.2",
    "@mastra/observability": "^1.14.1",
    "@mastra/stagehand": "^0.2.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
