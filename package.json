{
  "name": "ultimatrix",
  "version": "2.0.0",
  "description": "AI security researcher. Composer + 21 primitives, dynamically spawns specialist agents. Real exploit chains across 10 attack classes.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ultimatrix": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli/index.ts",
    "cli": "tsx src/cli/index.ts",
    "demo": "tsx src/cli/index.ts demo",
    "web": "tsx src/cli/index.ts web",
    "start": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "security",
    "pentesting",
    "ai-agents",
    "vulnerability-scanner",
    "red-team",
    "devsecops",
    "llm",
    "composer",
    "primitives",
    "recursion",
    "spawn-agents",
    "waf-bypass",
    "idor",
    "xss",
    "sqli",
    "ssti",
    "ssrf",
    "xxe",
    "csrf",
    "file-upload",
    "open-redirect",
    "security-headers"
  ],
  "author": "Ultimatrix Team",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/aws": "^1.3.9",
    "@langchain/core": "^1.1.47",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/groq": "^1.2.1",
    "@langchain/mistralai": "^1.1.0",
    "@langchain/openai": "^1.4.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "deepagents": "^1.10.2",
    "js-yaml": "^4.1.1",
    "langchain": "^1.4.2",
    "playwright": "^1.40.0",
    "ws": "^8.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "express": "^5.2.1",
    "fast-check": "^4.8.0",
    "ink": "^5.2.1",
    "ink-testing-library": "^4.0.0",
    "react": "^18.3.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  }
}
